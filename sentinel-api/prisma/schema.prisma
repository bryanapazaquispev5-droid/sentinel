generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  COMMUNITY_VERIFIED
  OFFICIALLY_VERIFIED
  DISMISSED
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VoteType {
  CONFIRM
  DISPUTE
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(USER)
  reputation   Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reports      Report[]
  votes        ReportVote[]
}

model Report {
  id            String       @id @default(cuid())
  userId        String
  category      String
  description   String
  latitude      Float
  longitude     Float
  severity      Severity     @default(MEDIUM)
  status        ReportStatus @default(PENDING)
  photoUrl      String?
  confirmations Int          @default(0)
  disputes      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes         ReportVote[]
}

model ReportVote {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  type      VoteType
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
}

model OfficialAlert {
  id          String   @id @default(cuid())
  externalId  String   @unique
  source      String
  title       String
  description String
  category    String
  latitude    Float?
  longitude   Float?
  severity    Severity @default(MEDIUM)
  sourceUrl   String?
  publishedAt DateTime
  createdAt   DateTime @default(now())
}
